    "art:town-gildmark": {
      "group": "town",
      "title": "Gildmark — the deepwater head",
      "file": "concept/A1-ART-05.png",
      "note": "Z-Image Turbo, local generation, ABP_1 from A1-geography-cluster1.md art briefs",
      "description": "Gildmark, a vertical port town stacked in five terraces up a rock headland, seen from the water at the end of the coastal road in low sun. Dressed stone at the base gives way to rendered plaster and timber above, every seaward face tarred black against the salt, with a glazed-cap tower crowning the silhouette above mudflats studded with wrecked-hull ribs.",
      "tags": ["cluster-1", "port-town", "gildmark", "coastal"],
      "source": "docs/worldbuilding/A1-geography-cluster1.md#A1-ART-05",
