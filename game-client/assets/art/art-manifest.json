    "art:map-cluster1": {
      "group": "map",
      "title": "Cluster 1 — the Meltwash basin",
      "file": "maps/cluster1-world.png",
      "note": "AUTHORED VECTOR, NOT GENERATED. Drawn by tools/mapforge/render-map.mjs from content/maps/cluster1-geography.json; the SVG beside this PNG (maps/cluster1-world.svg) is the artifact, the PNG is a 2000px raster of it for the storybook. Replaces an earlier Z-Image Turbo attempt, which could not draw this world’s coastline, roads or place names.",
      "description": "A single-sheet Bellfaith relay map of the Meltwash basin, drafted rather than painted: ink on cream parchment with one accent colour (bell-bronze) reserved for the 27 relay towers and their sight-lines. Real paths for the coastline, the Meltwash and the hatched Saltmire; roads carry their canon day-counts lettered along the legs, with waystations where each day ends; six towns, ten zones with level bands, the Ashvale Front drawn as a gradient whose northern deep is left as bare hatch, and a hard parchment edge along the top because the map does not pretend to know what lies past the ice.",
      "tags": [
        "cluster-1",
        "map",
        "bellfaith",
        "relay-map",
        "authored-vector",
        "svg"
      ],
      "source": "docs/worldbuilding/A1-geography-cluster1.md#A1-ART-01",
      "gen": {
        "method": "authored-vector",
        "generated": false,
        "tool": "tools/mapforge/render-map.mjs",
        "input": "content/maps/cluster1-geography.json",
        "vector": "maps/cluster1-world.svg",
        "raster": "rsvg-convert -w 2000",
        "deterministic": true,
        "width": 2000,
        "note": "No model, no sampler, no seed — this sheet is drawn from geometry, so there are no generation parameters to record. Re-run the tool to reproduce it byte-for-byte."
      }
    },
    "art:town-millcross": {
      "group": "town",
      "title": "Millcross — the crossing",
      "file": "concept/A1-ART-02.png",
      "note": "Z-Image Turbo, local generation, ABP_1 from A1-geography-cluster1.md art briefs",
      "description": "Millcross, a sprawling wall-less crossing town on both banks of a grey river, seen from the road at cart height in late afternoon. One mill-wheel housing is the only structure above one storey; a queue of loaded carts and led animals stretches toward the ford, and former refugee tents have grown plank walls with real doorframes.",
      "tags": ["cluster-1", "river-crossing", "market-town", "millcross"],
      "source": "docs/worldbuilding/A1-geography-cluster1.md#A1-ART-02",
      "gen": {
        "model": "z_image_turbo_bf16",
        "steps": 24,
        "cfg": 3,
        "seed": 12345,
        "width": 1280,
        "height": 832
      }
    },
    "art:town-embervale": {
      "group": "town",
      "title": "Embervale — the terraced hearths",
      "file": "concept/A1-ART-03.png",
      "note": "Z-Image Turbo, local generation, ABP_1 from A1-geography-cluster1.md art briefs",
      "description": "Embervale, a terraced hill town of six stacked ledges seen from the fields below at dusk, each ledge a row of slate roofs above a black clinker retaining wall. Forty low hearth-smoke plumes stand off the roofs, and ember-red banners hang along every ledge above figures in banded mourning cloth over faded militia colours.",
      "tags": ["cluster-1", "hill-town", "embervale", "mining"],
      "source": "docs/worldbuilding/A1-geography-cluster1.md#A1-ART-03",
      "gen": {
