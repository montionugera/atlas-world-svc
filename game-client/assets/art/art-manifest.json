    "art:town-norhollow": {
      "group": "town",
      "title": "Norhollow — the palisade",
      "file": "concept/A1-ART-04.png",
      "note": "Z-Image Turbo, local generation, ABP_1 from A1-geography-cluster1.md art briefs",
      "description": "Norhollow, a wooded hollow behind a continuous palisade of sharpened trunks, seen from the open flat in flat morning light so the wall reads as the town's entire silhouette. The open gate is the focal point, flanked by tally boards cut edge to edge with knife marks, with figures in layered furs over palisade-guard leathers.",
      "tags": ["cluster-1", "palisade-town", "norhollow", "timber"],
      "source": "docs/worldbuilding/A1-geography-cluster1.md#A1-ART-04",
