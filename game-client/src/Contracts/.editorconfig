# Generated schema contracts (copied from colyseus-server/generated/csharp/Runtime).
# The codegen emits `= null` on non-nullable fields and `= default(string)`, which trip
# nullable warnings. These files are drift-checked copies — we must not hand-edit them —
# so suppress the codegen-only warnings HERE (path-scoped) rather than project-wide,
# keeping the hand-written client code under full nullable strictness.
[*.cs]
dotnet_diagnostic.CS8618.severity = none
dotnet_diagnostic.CS8625.severity = none
