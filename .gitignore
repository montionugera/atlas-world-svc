# Dependencies
node_modules/
# also ignore node_modules when it is a symlink (e.g. a dev worktree linking the
# primary checkout's modules) — the trailing-slash rule above only matches dirs
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
build/
# mapforge draft runs: build/mapforge/<seed8>-<generatorVersion>/, a COMPLETE
# content root the generator writes from scratch and promote-world.mjs
# reconciles. Never committed — Plan C commits zero spine node bytes.
# REDUNDANT, and kept as documentation only: `build/` two lines up already
# covers it. It says where the draft roots live, it does not make them ignored.
build/mapforge/
dist/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Docker

# Nakama specific
data/
# ...but `data/` above is UNANCHORED, so it matches a directory named `data`
# at ANY depth — including source directories. tools/asset-storybook/js/data/
# is the storybook's pure (no-DOM, node-testable) layer and must be tracked.
# Negating the directory itself is required: git does not descend into an
# excluded directory, so negating only the files inside would not work.
!tools/asset-storybook/js/data/
# ps-release-workflow (gitignored state)
.claude/state/
.claude/worktrees/

# Rendered spec/plan view artifacts (local only)
docs/superpowers/**/*.html
docs/worldbuilding/**/*.html
docs/research/**/*.html
.claude/idea_backlog/**/*.html
.claude/refined_backlog/**/*.html

# F-043: gen-world CLI output — candidate spine nodes staged for panel review,
# default out dir of tools/mapforge/gen-world.mjs. Never committed directly.
#
# RESTORED by the seam-6 fix pass. Task 10 removed this rule as part of
# retiring gen-world.mjs, but the tool and lib/world-gen.mjs are still in the
# tree — deleting them is Task 11's acceptance criterion 13. Until then,
# anyone running the old CLI dirties `git status` under content/, which is the
# migration invariant of STATE §3 and acceptance criteria 6 and 9. Delete this
# rule in the SAME commit that deletes its producer, not before.
content/spine/candidates/
