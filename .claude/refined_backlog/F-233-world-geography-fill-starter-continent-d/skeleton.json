  "basin_features": {
    "trunk_river": {
      "name": "the Glaze River",
      "course": [
        "district-cardamom-kiln-caldera",
        "district-cinnamon-bellows-bluff",
        "district-ginger-steam-terraces",
        "district-glaze-river-delta"
      ],
      "note": "Springs in the caldera (elevation 3), falls past the bluff and the steam terraces (2), skirts the south-west edge of Teacup Meadows where the meadow creeks join it (1), and fans out in the delta (0). The delta's outer mouth faces south. Every water field on or beside the course refers to it by this name; no other district claims a different river."
    },
    "prevailing_wind": "westerly: air climbs the western ridge, crosses the basin and leaves over the eastern highlands. Smells and sounds carry west to east.",
    "temperature_rule": "The continent canon says the basin is kept at perpetual spring. No frost, ice, rime or snow anywhere. 'cool' means wind and thin air at height, not freezing.",
    "terrain_group_content": {
      "Old Wilds": "old forest is present in every Old Wilds district (glossary: deep forest, hidden valleys, old paths). Cinnamon-Bellows Bluff is the forest edge with open ground; Wind-Chime Ridge is a ridge above a deep forested valley.",
      "Green Lowlands": "river valleys, plains, open woodland.",
      "Stone Highlands": "ore, cliffs, mountain passes, upland plain."
    }
  }
