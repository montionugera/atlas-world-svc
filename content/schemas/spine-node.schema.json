{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spine-node.schema.json",
  "title": "Spine node — SHAPE ONLY. Every numeric floor/ceiling lives in checkSpine()'s G-* gates, never here: the gate continues past a schema-invalid doc, so a bound duplicated into the schema turns its gate rule into dead code (town-plan.test.mjs:105-118 discipline). Plan B Task 2 closed the root: the union of keys across all committed node files is exactly the enumerated set, so a typo'd field name is now a schema failure instead of a silent accept.",
  "type": "object",
  "required": ["id", "tier", "parentId", "title", "seed", "placement", "composition"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "tier": { "enum": ["world", "playroot", "continent", "ocean", "playspace", "fixture", "region", "sea", "town", "site"] },
    "parentId": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["authored", "generator", "source"],
      "properties": {
        "authored": { "enum": ["hand", "generated", "derived"] },
        "generator": { "type": ["object", "null"] },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "frozen": { "type": "boolean" },
    "absoluteAnchor": { "type": "array", "items": { "type": "number" } },
    "seed": {
      "type": "object",
      "required": ["value", "epoch", "why"],
      "properties": {
        "value": { "type": "string" },
        "epoch": { "type": "integer" },
        "why": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "required": ["shape", "anchor"],
      "properties": {
        "shape": { "enum": ["polygon", "rect", "point"] },
        "points": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
        "rect": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } },
          "additionalProperties": false
        },
        "at": { "type": "array", "items": { "type": "number" } },
        "anchor": { "type": "array", "items": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "interior": { "type": "object" },
    "composition": { "type": "object", "additionalProperties": { "type": "number" } },
    "interstitial": { "type": ["object", "null"] },
    "interstitialUnsurveyed": { "type": "boolean" },
    "compositionTolerance": { "type": ["number", "null"] },
    "toleranceWhy": { "type": ["string", "null"] },
    "terrainKind": { "type": ["string", "null"] },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "attrs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["point", "line", "area"] },
          "at": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          "points": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } },
          "ring": { "type": "array", "minItems": 3, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } },
          "offSheet": { "type": "boolean" },
          "type": { "type": ["string", "null"] },
          "attrs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": ["string", "null"] },
              "note": { "type": "string" },
              "role": { "type": "string" },
              "town": { "type": "string" },
              "reaches": { "type": "array" },
              "labelAt": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "tidalLimit": { "type": "object" },
              "ford": { "type": "object" },
              "hardEdgeAtY": { "type": "number" },
              "detached": { "type": "boolean" },
              "inert": { "type": "boolean" },
              "hazard": { "type": "object" }
            }
          }
        }
      }
    },
    "bands": { "type": "array" },
    "runtime": { "type": ["object", "null"] },
    "representsNodeId": { "type": ["string", "null"] },
    "lore": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "levelBand": { "type": ["array", "null"] },
    "derived": { "type": "object" },
    "file": {
      "type": "string",
      "description": "NOT a committed key. loadSpine() (scripts/lib/spine.mjs:220) pushes `{ ...doc, file }` and checkSpine() validates THAT object, so closing the root without enumerating it fails all 44 nodes on `must NOT have additional properties`. Enumerated here rather than stripped at the call site because the loader-injected stem is what G-ID checks the id against."
    }
  }
}
