{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas story entry (region | faction)",
  "description": "Machine-readable story entry extracted from content/story/bible.md. Discriminated by `kind`. v0 covers region + faction only (era/timeline is a single bible stub, not modeled yet).",
  "type": "object",
  "required": ["id", "title", "kind", "summary", "links"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["region", "faction"] },
    "summary": { "type": "string", "minLength": 1 },
    "links": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "dangerTier": { "enum": ["safe", "low", "mid", "high"] },
    "disposition": { "enum": ["hostile", "friendly", "neutral"] },
    "mobFamily": {
      "type": "array",
      "items": { "type": "string", "pattern": "^mob:[a-z0-9_]+$" }
    }
  },
  "oneOf": [
    {
      "title": "region",
      "properties": { "kind": { "const": "region" } },
      "required": ["kind"],
      "not": {
        "anyOf": [
          { "required": ["disposition"] },
          { "required": ["mobFamily"] }
        ]
      }
    },
    {
      "title": "faction",
      "properties": { "kind": { "const": "faction" } },
      "required": ["kind", "disposition", "mobFamily"],
      "not": { "required": ["dangerTier"] }
    }
  ]
}
