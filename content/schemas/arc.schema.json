{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas story node: arc",
  "description": "One entry of content/story/arcs.json. Part of the F-012 per-kind story graph (see docs/superpowers/specs/2026-07-22-epic-story-pipeline-design.md).",
  "type": "object",
  "required": ["id", "title", "kind", "summary", "links", "actId", "questIds"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^arc-[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "const": "arc" },
    "summary": { "type": "string", "minLength": 1 },
    "links": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "actId": { "type": "string", "pattern": "^act-[a-z0-9]+(-[a-z0-9]+)*$" },
    "questIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^quest-[a-z0-9]+(-[a-z0-9]+)*$" }
    }
  }
}
