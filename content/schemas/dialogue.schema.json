{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas story node: dialogue",
  "description": "One entry of content/story/dialogue.json. Part of the F-012 per-kind story graph (see docs/superpowers/specs/2026-07-22-epic-story-pipeline-design.md).",
  "type": "object",
  "required": ["id", "title", "kind", "summary", "links", "speaker", "lines"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^dlg-[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "const": "dialogue" },
    "summary": { "type": "string", "minLength": 1 },
    "links": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "speaker": { "type": "string", "pattern": "^char-[a-z0-9]+(-[a-z0-9]+)*$" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "context": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "unlockedBy": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(quest|event|act)-[a-z0-9]+(-[a-z0-9]+)*$" }
    }
  }
}
