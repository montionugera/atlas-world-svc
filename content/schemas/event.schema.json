{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas story node: event",
  "description": "One entry of content/story/events.json. Part of the F-012 per-kind story graph (see docs/superpowers/specs/2026-07-22-epic-story-pipeline-design.md).",
  "type": "object",
  "required": ["id", "title", "kind", "summary", "links", "timelineOrder", "involves"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^event-[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "const": "event" },
    "summary": { "type": "string", "minLength": 1 },
    "links": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "timelineOrder": { "type": "integer" },
    "involves": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "triggeredBy": { "type": "string", "pattern": "^quest-[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
