{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas story node: region",
  "description": "One entry of content/story/regions.json. Part of the F-012 per-kind story graph (see docs/superpowers/specs/2026-07-22-epic-story-pipeline-design.md).",
  "type": "object",
  "required": ["id", "title", "kind", "summary", "links", "dangerTier"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^region-[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "const": "region" },
    "summary": { "type": "string", "minLength": 1 },
    "links": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "dangerTier": { "enum": ["safe", "low", "mid", "high"] }
  }
}
