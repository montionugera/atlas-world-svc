{
  "schema_version": "1.0",
  "id": "atlas-composable-map-feature-layers",
  "title": "Composable 6-Layer Vector & Terrain Feature Pipeline (Incremental Edit Without Full Map Rebuild)",
  "design_rationale": "Separates top-down cartography into 6 independent, hash-keyed scene-graph layers inspired by Lineage II Freya/Interlude official maps (l2sanctum.net) and Google Maps GIS. Editing a single walkway spline, river bend, highland contour, or tree cluster hot-patches only its target SVG/Canvas <g data-feature-layer='...'> group in <15ms without regenerating the base elevation raster plate.",
  "scale_bar_calibration": {
    "overland_world_span_meters": 400000,
    "overland_regional_view_meters": 10400,
    "field_tactical_span_meters": 2080,
    "town_street_span_meters": 1040,
    "dungeon_floor_span_meters": 624,
    "svg_canvas_width_px": 1040,
    "svg_canvas_height_px": 500,
    "google_scale_steps_meters": [
      20,
      50,
      100,
      200,
      500,
      1000,
      2000,
      5000,
      10000,
      20000,
      50000
    ]
  },
  "pipeline_layers": [
    {
      "layer_id": "layer_0_base_elevation_dem",
      "order": 0,
      "name": "Base Elevation DEM & Biome Relief",
      "rebuild_scope": "cached_static_plate",
      "description": "2080x1000 2x Retina hypsometric tint, bathymetry, and hillshade raster base. Never rebuilt when editing roads, rivers, or foliage."
    },
    {
      "layer_id": "layer_1_hydrology_splines",
      "order": 1,
      "name": "Rivers, Canals, Sandbanks & Bridges",
      "rebuild_scope": "incremental_vector_spline",
      "description": "Meandering river ribbons with outer shallow sandbank/cerulean strokes, deep water core, rapids, and stone/timber bridge crossings."
    },
    {
      "layer_id": "layer_2_topography_cliffs_and_highlands",
      "order": 2,
      "name": "Highland Plateaus, Cliff Hachures, Snow Peaks & Lava Craters",
      "rebuild_scope": "incremental_contour_polygon",
      "description": "Multi-tiered elevation ledges with directional NW->SE drop shadows, cliff-face hachure ticks, alpine snowcaps, and volcanic calderas."
    },
    {
      "layer_id": "layer_3_road_and_walkway_network",
      "order": 3,
      "name": "Arterial Highways (12m+), Patrol Roads (8m) & Small Walkways (3.5m-4.5m)",
      "rebuild_scope": "incremental_polyline_graph",
      "description": "Three-tier road hierarchy: paved arterial highways (>=12m), secondary gravel patrol trails (8m), and small winding dirt footpaths (3.5m-4.5m) branching to shrines, camps, and quest targets."
    },
    {
      "layer_id": "layer_4_foliage_and_canopy_scatters",
      "order": 4,
      "name": "Top-Down Tree Canopy Clusters, Swamp Reeds & Rock Outcrops",
      "rebuild_scope": "incremental_poisson_scatter",
      "description": "Seeded multi-crown tree clusters with ground shadows and biome-specific canopy tints. Enforces 1.05m chibi scale law (ground grass <=0.35m, bushes <=0.65m)."
    },
    {
      "layer_id": "layer_5_architectural_compounds_and_quest_rings",
      "order": 5,
      "name": "Top-Down Walled Compounds, Coliseums, Ruins & L2Sanctum Quest Rings",
      "rebuild_scope": "incremental_poi_overlay",
      "description": "Baked top-down stone compounds (circular coliseums, giant bone basins, watchtower ruins) and l2sanctum-style golden double-ring quest target markers."
    }
  ],
