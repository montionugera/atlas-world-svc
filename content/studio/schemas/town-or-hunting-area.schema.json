{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-world.joymify.com/studio/schemas/town-or-hunting-area.schema.json",
  "title": "StudioTownOrHuntingAreaNode",
  "allOf": [
    {
      "$ref": "common-mystery.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "map_id",
    "parent_district_id",
    "parent_continent_id",
    "node_type",
    "status",
    "core_rationale",
    "is_starter_town",
    "grid_coordinates",
    "level_range",
    "quality_checklist"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^(town|hunting-area|dungeon)-[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "map_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_district_id": {
      "type": "string",
      "pattern": "^district-[a-z0-9-]+$"
    },
    "parent_continent_id": {
      "type": "string",
      "pattern": "^continent-[0-9]{2}-[a-z0-9-]+$"
    },
    "node_type": {
      "type": "string",
      "enum": [
        "town",
        "hunting_area",
        "dungeon"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "canon",
        "draft",
        "mystery"
      ]
    },
    "core_rationale": {
      "type": "string",
      "minLength": 20
    },
    "is_starter_town": {
      "type": "boolean"
    },
    "grid_coordinates": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "floor_index": {
      "type": "integer"
    },
    "level_range": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "starter_arrival_binding": {
      "type": "object",
      "required": [
        "world_history_id",
        "arrival_rationale",
        "spawn_point_meters",
        "safe_zone_radius_meters"
      ],
      "properties": {
        "world_history_id": {
          "type": "string"
        },
        "arrival_rationale": {
          "type": "string",
          "minLength": 20
        },
        "spawn_point_meters": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "safe_zone_radius_meters": {
          "type": "number",
          "minimum": 15.0
        }
      }
    },
    "terrain_tile": {
      "type": "object",
      "required": [
        "preview_thumbnail",
        "dimensions_meters",
        "biome_palette",
        "max_terrace_step_meters",
        "water_feature"
      ],
      "properties": {
        "preview_thumbnail": {
          "type": "string"
        },
        "dimensions_meters": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 200
            },
            "height": {
              "type": "number",
              "minimum": 200
            }
          }
        },
        "biome_palette": {
          "type": "string"
        },
        "max_terrace_step_meters": {
          "type": "number",
          "maximum": 0.25
        },
        "water_feature": {
          "type": "string"
        }
      }
    },
    "portals": {
      "type": "object",
      "properties": {
        "North": {
          "type": [
            "object",
            "null"
          ]
        },
        "South": {
          "type": [
            "object",
            "null"
          ]
        },
        "East": {
          "type": [
            "object",
            "null"
          ]
        },
        "West": {
          "type": [
            "object",
            "null"
          ]
        },
        "Dungeon": {
          "type": [
            "object",
            "null"
          ]
        },
        "Exit": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "resident_spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "spawn_id",
          "monster_id",
          "monster_name",
          "spawn_count",
          "respawn_seconds",
          "level",
          "element",
          "size",
          "race",
          "family",
          "item_drops",
          "monster_card_drop"
        ],
        "properties": {
          "spawn_id": {
            "type": "string"
          },
          "monster_id": {
            "type": "string"
          },
          "monster_name": {
            "type": "string"
          },
          "spawn_count": {
            "type": "integer",
            "minimum": 1
          },
          "respawn_seconds": {
            "type": "number",
            "minimum": 1.0
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "element": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "enum": [
              "Small",
              "Medium",
              "Large"
            ]
          },
          "race": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "item_drops": {
            "type": "array",
            "minItems": 1
          },
          "monster_card_drop": {
            "type": "object",
            "required": [
              "card_id",
              "card_name",
              "drop_chance_percent",
              "equipment_slot"
            ]
          }
        }
      }
    },
    "asset_kit_bindings": {
      "type": "object",
      "required": [
        "player_scale_band_meters",
        "max_grass_height_meters",
        "max_bush_height_meters",
        "main_road_width_meters",
        "footpath_width_meters",
        "three_dimensional_assets"
      ]
    }
  }
}
