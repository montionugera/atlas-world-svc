{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-world.local/schemas/t-shaped-world-atlas.schema.json",
  "title": "T-Shaped World & Continent Atlas (L2J.RU / L2Hub / PMFun Top-Down Standard)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "design_philosophy",
    "reference_benchmarks",
    "world_grid_spec",
    "t_breadth_continents",
    "t_breadth_zone_directory",
    "t_deep_validation_slice",
    "multi_floor_dungeons"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "status": { "type": "string", "enum": ["canon", "draft"] },
    "design_philosophy": { "type": "string", "minLength": 40 },
    "race_spawn_locations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/raceSpawnLocationSpec" }
    },
    "race_growth_routes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/raceGrowthRouteSpec" }
    },
    "town_blueprints": {
      "type": "array",
      "items": { "$ref": "#/$defs/townBlueprintSpec" }
    },
    "field_tactical_blueprints": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldTacticalBlueprintSpec" }
    },
    "fortress_blueprints": {
      "type": "array",
      "items": { "$ref": "#/$defs/fortressBlueprintSpec" }
    },
    "reference_benchmarks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_name", "urls", "extracted_patterns"],
        "properties": {
          "source_name": { "type": "string" },
          "urls": { "type": "array", "items": { "type": "string" } },
          "extracted_patterns": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "world_grid_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coord_bounds_x", "coord_bounds_y", "grid_tile_sectors", "map_view_modes", "zone_categories"],
      "properties": {
        "coord_bounds_x": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "coord_bounds_y": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "grid_tile_sectors": { "type": "string" },
        "map_view_modes": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "zone_categories": { "type": "array", "items": { "type": "string" }, "minItems": 6 }
      }
    },
    "t_breadth_continents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "continent_id",
          "name",
          "l2_archetype_analog",
          "level_band",
          "growth_stages",
          "grid_sector_bounds",
          "summary",
          "territories"
        ],
        "properties": {
          "continent_id": { "type": "string" },
          "name": { "type": "string" },
          "l2_archetype_analog": { "type": "string" },
          "level_band": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "growth_stages": { "type": "array", "items": { "type": "string" } },
          "grid_sector_bounds": { "type": "string" },
          "summary": { "type": "string" },
          "territories": { "type": "array", "items": { "type": "string" }, "minItems": 3 }
        }
      }
    },
    "t_breadth_zone_directory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starting_towns",
        "other_castle_and_hub_towns",
        "fields_and_hunting_areas",
        "regular_dungeons",
        "seven_signs_seal_catacombs",
        "harbors_clanhalls_and_forts"
      ],
      "properties": {
        "starting_towns": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/zoneIndexItem" } },
        "other_castle_and_hub_towns": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/zoneIndexItem" } },
        "fields_and_hunting_areas": { "type": "array", "minItems": 16, "items": { "$ref": "#/$defs/zoneIndexItem" } },
        "regular_dungeons": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/zoneIndexItem" } },
        "seven_signs_seal_catacombs": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/zoneIndexItem" } },
        "harbors_clanhalls_and_forts": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/zoneIndexItem" } }
      }
    },
    "t_deep_validation_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_rationale",
        "deep_town",
        "deep_field_zone",
        "deep_dungeon",
        "deep_mob_database"
      ],
      "properties": {
        "slice_rationale": { "type": "string" },
        "deep_town": { "$ref": "#/$defs/deepTownSpec" },
        "deep_field_zone": { "$ref": "#/$defs/deepFieldSpec" },
        "deep_dungeon": { "$ref": "#/$defs/deepDungeonSpec" },
        "deep_mob_database": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/deepMobSheet" }
        }
      }
    },
    "multi_floor_dungeons": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/multiFloorDungeonSpec" }
    }
  },
  "$defs": {
    "zoneIndexItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "studio_node_id",
        "name",
        "category",
        "continent_id",
        "territory_name",
        "level_header",
        "level_band",
        "grid_sector",
        "loc_coord",
        "l2_reference_analog",
        "race_or_seal_affinity",
        "connected_zone_ids",
        "t_depth_status"
      ],
      "properties": {
        "zone_id": { "type": "string" },
        "studio_node_id": { "type": "string" },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "starting_town",
            "castle_or_hub_town",
            "field_hunting_zone",
            "regular_dungeon",
            "seal_catacomb_necropolis",
            "harbor",
            "clan_hall",
            "fortress"
          ]
        },
        "continent_id": { "type": "string" },
        "territory_name": { "type": "string" },
        "level_header": { "type": "string" },
        "level_band": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "grid_sector": { "type": "string" },
        "loc_coord": { "type": "string" },
        "l2_reference_analog": { "type": "string" },
        "race_or_seal_affinity": { "type": "string" },
        "connected_zone_ids": { "type": "array", "items": { "type": "string" } },
        "t_depth_status": { "type": "string", "enum": ["t_breadth_indexed", "t_deep_validated"] },
        "town_blueprint": { "$ref": "#/$defs/townBlueprintSpec" },
        "field_tactical_blueprint": { "$ref": "#/$defs/fieldTacticalBlueprintSpec" },
        "fortress_blueprint": { "$ref": "#/$defs/fortressBlueprintSpec" }
      }
    },
    "raceSpawnLocationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "race_id",
        "race_key",
        "race_name",
        "starter_town_zone_id",
        "starter_town_node_id",
        "starter_town_name",
        "continent_id",
        "district_id",
        "loc_coord",
        "starter_shrine_monument",
        "macro_map_marker",
        "town_blueprint_marker"
      ],
      "properties": {
        "race_id": { "type": "string" },
        "race_key": { "type": "string" },
        "race_name": { "type": "string" },
        "starter_town_zone_id": { "type": "string" },
        "starter_town_node_id": { "type": "string" },
        "starter_town_name": { "type": "string" },
        "continent_id": { "type": "string" },
        "district_id": { "type": "string" },
        "loc_coord": { "type": "string" },
        "starter_shrine_monument": { "type": "string" },
        "macro_map_marker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "icon", "grid_sector", "loc_coord"],
          "properties": {
            "label": { "type": "string" },
            "icon": { "type": "string" },
            "grid_sector": { "type": "string" },
            "loc_coord": { "type": "string" }
          }
        },
        "town_blueprint_marker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "shrine_building_number", "x_pct", "y_pct", "loc_coord"],
          "properties": {
            "label": { "type": "string" },
            "shrine_building_number": { "type": "integer", "minimum": 1, "maximum": 12 },
            "x_pct": { "type": "number" },
            "y_pct": { "type": "number" },
            "loc_coord": { "type": "string" }
          }
        }
      }
    },
    "spawnRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npc_id",
        "name",
        "entity_type",
        "level",
        "aggro",
        "race_key",
        "race_badge",
        "hp_multiplier",
        "protections",
        "weaknesses",
        "spawn_count",
        "respawn_sec",
        "loc_coord"
      ],
      "properties": {
        "npc_id": { "type": "integer" },
        "name": { "type": "string" },
        "entity_type": { "type": "string", "enum": ["Guard", "NPC", "Monster", "Minion", "Quest Monster", "Mini-Boss", "Raid", "RaidBoss", "MVP"] },
        "level": { "type": "integer" },
        "aggro": { "type": "string", "enum": ["Yes", "No"] },
        "race_key": { "type": "string" },
        "race_badge": { "type": "string" },
        "hp_multiplier": { "type": "string" },
        "protections": { "type": "array", "items": { "type": "string" } },
        "weaknesses": { "type": "array", "items": { "type": "string" } },
        "spawn_count": { "type": "integer" },
        "respawn_sec": { "type": "integer" },
        "loc_coord": { "type": "string" }
      }
    },
    "deepTownSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "studio_node_id",
        "header_title",
        "continent_id",
        "race_key",
        "grid_sector",
        "loc_coord",
        "l2_reference_url",
        "dual_map_layers",
        "town_landmarks",
        "gatekeeper_routes",
        "npc_and_guard_table",
        "town_blueprint"
      ],
      "properties": {
        "zone_id": { "type": "string" },
        "studio_node_id": { "type": "string" },
        "header_title": { "type": "string" },
        "continent_id": { "type": "string" },
        "race_key": { "type": "string" },
        "grid_sector": { "type": "string" },
        "loc_coord": { "type": "string" },
        "l2_reference_url": { "type": "string" },
        "dual_map_layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["common_parchment_map", "top_down_radar_map"],
          "properties": {
            "common_parchment_map": { "type": "string" },
            "top_down_radar_map": { "type": "string" }
          }
        },
        "town_landmarks": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["landmark_id", "name", "function", "map_xy_pct"],
            "properties": {
              "landmark_id": { "type": "string" },
              "name": { "type": "string" },
              "function": { "type": "string" },
              "map_xy_pct": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
            }
          }
        },
        "gatekeeper_routes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_zone_id", "target_name", "recommended_level", "fee_adena"],
            "properties": {
              "target_zone_id": { "type": "string" },
              "target_name": { "type": "string" },
              "recommended_level": { "type": "string" },
              "fee_adena": { "type": "integer" }
            }
          }
        },
        "npc_and_guard_table": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/$defs/spawnRow" }
        },
        "town_blueprint": { "$ref": "#/$defs/townBlueprintSpec" }
      }
    },
    "townBlueprintSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype_subtitle",
        "wall_polygon_pct",
        "gates",
        "streets",
        "buildings",
        "service_marks",
        "npc_roster"
      ],
      "properties": {
        "zone_id": { "type": "string" },
        "studio_node_id": { "type": "string" },
        "archetype_subtitle": { "type": "string" },
        "race_spawn_point": {
          "type": "object",
          "additionalProperties": false,
          "required": ["race_key", "shrine_name", "loc_coord", "x_pct", "y_pct"],
          "properties": {
            "race_key": { "type": "string" },
            "shrine_name": { "type": "string" },
            "loc_coord": { "type": "string" },
            "x_pct": { "type": "number" },
            "y_pct": { "type": "number" }
          }
        },
        "refinement_anvils": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["anvil_id", "name", "npc_name", "building_number", "x_pct", "y_pct"],
            "properties": {
              "anvil_id": { "type": "string" },
              "name": { "type": "string" },
              "npc_name": { "type": "string" },
              "building_number": { "type": "integer", "minimum": 1, "maximum": 12 },
              "x_pct": { "type": "number" },
              "y_pct": { "type": "number" }
            }
          }
        },
        "wall_polygon_pct": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "gates": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_id", "name", "direction", "x_pct", "y_pct", "target_zone_id"],
            "properties": {
              "gate_id": { "type": "string" },
              "name": { "type": "string" },
              "direction": { "type": "string" },
              "x_pct": { "type": "number" },
              "y_pct": { "type": "number" },
              "target_zone_id": { "type": "string" }
            }
          }
        },
        "streets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["street_id", "name", "width_meters", "path_pct"],
            "properties": {
              "street_id": { "type": "string" },
              "name": { "type": "string" },
              "width_meters": { "type": "number" },
              "path_pct": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "buildings": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "building_number",
              "building_id",
              "name",
              "function",
              "x_pct",
              "y_pct",
              "w_pct",
              "h_pct",
              "roof_color"
            ],
            "properties": {
              "building_number": { "type": "integer", "minimum": 1, "maximum": 12 },
              "building_id": { "type": "string" },
              "name": { "type": "string" },
              "function": { "type": "string" },
              "x_pct": { "type": "number" },
              "y_pct": { "type": "number" },
              "w_pct": { "type": "number" },
              "h_pct": { "type": "number" },
              "roof_color": { "type": "string" }
            }
          }
        },
        "service_marks": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mark_id",
              "mark_type",
              "label",
              "icon",
              "building_number",
              "x_pct",
              "y_pct",
              "npc_name",
              "description"
            ],
            "properties": {
              "mark_id": { "type": "string" },
              "mark_type": {
                "type": "string",
                "enum": [
                  "equip_shop",
                  "consumable_shop",
                  "blacksmith",
                  "refinement_anvils",
                  "temple",
                  "warehouse",
                  "guild",
                  "gatekeeper"
                ]
              },
              "label": { "type": "string" },
              "icon": { "type": "string" },
              "building_number": { "type": "integer", "minimum": 1, "maximum": 12 },
              "x_pct": { "type": "number" },
              "y_pct": { "type": "number" },
              "npc_name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "npc_roster": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "building_number",
              "npc_id",
              "name",
              "role_category",
              "role_title",
              "color_hex",
              "x_pct",
              "y_pct",
              "loc_coord"
            ],
            "properties": {
              "building_number": { "type": "integer", "minimum": 1, "maximum": 12 },
              "npc_id": { "type": "integer" },
              "name": { "type": "string" },
              "role_category": {
                "type": "string",
                "enum": ["trainer", "merchant", "warehouse", "guard", "gatekeeper", "priest"]
              },
              "role_title": { "type": "string" },
              "color_hex": { "type": "string" },
              "x_pct": { "type": "number" },
              "y_pct": { "type": "number" },
              "loc_coord": { "type": "string" }
            }
          }
        },
        "shop_and_refinement_catalog": {
          "$ref": "#/$defs/shopAndRefinementCatalogSpec"
        }
      }
    },
    "raceGrowthRouteSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "race_key",
        "race_label",
        "race_name",
        "color_hex",
        "summary",
        "waypoints"
      ],
      "properties": {
        "route_id": { "type": "string" },
        "race_key": { "type": "string" },
        "race_label": {
          "type": "string",
          "enum": ["Human", "Lunar", "Ogre/Orc", "Dwarf", "Dark-Lunar", "Furral"]
        },
        "race_name": { "type": "string" },
        "color_hex": { "type": "string" },
        "summary": { "type": "string" },
        "waypoints": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_index",
              "stage_code",
              "zone_id",
              "name",
              "l2_alias",
              "loc",
              "level_range",
              "travel_mode",
              "milestone_goal"
            ],
            "properties": {
              "step_index": { "type": "integer", "minimum": 1 },
              "stage_code": {
                "type": "string",
                "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]
              },
              "zone_id": { "type": "string" },
              "name": { "type": "string" },
              "l2_alias": { "type": "string" },
              "loc": { "type": "string" },
              "level_range": { "type": "string" },
              "travel_mode": {
                "type": "string",
                "enum": [
                  "footpath",
                  "highway",
                  "gatekeeper_teleport",
                  "dungeon_warp",
                  "sea_or_airship"
                ]
              },
              "milestone_goal": { "type": "string" }
            }
          }
        }
      }
    },
    "shopAndRefinementCatalogSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equip_shop_stock",
        "consumable_shop_stock",
        "refinement_anvil_rates",
        "blacksmith_material_spoils"
      ],
      "properties": {
        "equip_shop_stock": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "name", "category", "grade", "stats", "price_adena", "max_refinement"],
            "properties": {
              "item_id": { "type": "integer" },
              "name": { "type": "string" },
              "category": { "type": "string", "enum": ["Weapon", "Armor", "Shield", "Accessory"] },
              "grade": { "type": "string" },
              "stats": { "type": "string" },
              "price_adena": { "type": "integer" },
              "max_refinement": { "type": "string" }
            }
          }
        },
        "consumable_shop_stock": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "name", "category", "effect", "price_adena"],
            "properties": {
              "item_id": { "type": "integer" },
              "name": { "type": "string" },
              "category": { "type": "string", "enum": ["Potion", "Soulshot", "Spiritshot", "Scroll"] },
              "effect": { "type": "string" },
              "price_adena": { "type": "integer" }
            }
          }
        },
        "refinement_anvil_rates": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enchant_range",
              "success_rate_pct",
              "stat_bonus",
              "failure_penalty",
              "required_catalyst",
              "material_spoils"
            ],
            "properties": {
              "enchant_range": { "type": "string" },
              "success_rate_pct": { "type": "number" },
              "stat_bonus": { "type": "string" },
