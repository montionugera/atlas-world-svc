{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-world.joymify.com/studio/schemas/continent.schema.json",
  "title": "StudioContinent",
  "allOf": [
    {
      "$ref": "common-mystery.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "core_rationale",
    "parent_world_history_causes",
    "quality_checklist"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^continent-[0-9]{2}-[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "type": "string",
      "enum": [
        "canon",
        "draft",
        "mystery"
      ]
    },
    "core_rationale": {
      "type": "string",
      "minLength": 20
    },
    "parent_world_history_causes": {
      "type": "object",
      "required": [
        "world_history_id",
        "god_patron_ids",
        "war_scar_ids",
        "causal_summary"
      ],
      "properties": {
        "world_history_id": {
          "type": "string",
          "pattern": "^world-history-[a-z0-9-]+$"
        },
        "god_patron_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^god-[a-z0-9-]+$"
          }
        },
        "war_scar_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^scar-[a-z0-9-]+$"
          }
        },
        "causal_summary": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "level_band": {
      "type": "object",
      "required": [
        "min_level",
        "max_level"
      ],
      "properties": {
        "min_level": {
          "type": "integer",
          "minimum": 1
        },
        "max_level": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "climate_profile": {
      "type": "object",
      "required": [
        "macro_biome",
        "weather_phenomena",
        "skybox_palette"
      ],
      "properties": {
        "macro_biome": {
          "type": "string",
          "minLength": 10
        },
        "weather_phenomena": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "skybox_palette": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "civilization_style": {
      "type": "object",
      "required": [
        "culture_archetype",
        "architecture_motif",
        "character_scale_adaptation"
      ],
      "properties": {
        "culture_archetype": {
          "type": "string",
          "minLength": 10
        },
        "architecture_motif": {
          "type": "string",
          "minLength": 10
        },
        "character_scale_adaptation": {
          "type": "string",
          "minLength": 20,
          "description": "How this continent's architecture honors the 90 to 120 centimeter character scale law."
        }
      }
    },
    "travel_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_continent_id",
          "travel_mode",
          "hub_name",
          "status",
          "unlock_rationale"
        ],
        "properties": {
          "target_continent_id": {
            "type": "string",
            "pattern": "^continent-[0-9]{2}-[a-z0-9-]+$"
          },
          "travel_mode": {
            "type": "string",
            "enum": [
              "port_ferry",
              "airship",
              "dimensional_rift",
              "ancient_bridge",
              "root_train"
            ]
          },
          "hub_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "locked_by_story",
              "locked_by_mystery"
            ]
          },
          "unlock_rationale": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "district_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^district-[a-z0-9-]+$"
      }
    },
    "district_links": {
      "type": "array",
      "description": "F-233 optional district-to-district routes; enables GEO-01..07 for this continent.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "a",
          "b",
          "gateway",
          "route_type",
          "walk_minutes",
          "transition",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "gateway": {
            "type": "object",
            "required": [
              "type",
              "name"
            ],
            "properties": {
              "type": {
                "enum": [
                  "road",
                  "bridge",
                  "pass",
                  "tunnel",
                  "ford",
                  "stairs"
                ]
              },
              "name": {
                "type": "string"
              }
            }
          },
          "route_type": {
            "enum": [
              "main_road",
              "wilderness_trail",
              "ancient_route"
            ]
          },
          "walk_minutes": {
            "type": "number",
            "minimum": 8,
            "maximum": 30
          },
          "transition": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "built"
            ],
            "description": "F-235 build priority; built = a node portal already exists."
          }
        },
        "description": "F-235: priority is required by GEO-10 (kept optional here so older continents stay valid)."
      }
    },
    "transport_links": {
      "type": "array",
      "description": "F-235 declared non-adjacent transport between districts.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "a",
          "b",
          "mode",
          "note",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "caravan",
              "boat",
              "duct_route"
            ]
          },
          "note": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "legacy_portals": {
      "type": "array",
      "description": "F-235 existing cross-district node portals not covered by a link, each with a ruling. GEO-09 fails when an entry no longer matches a portal.",
      "items": {
        "type": "object",
        "required": [
          "from_node_id",
          "to_node_id",
          "district_pair",
          "ruling",
          "reason"
        ],
        "properties": {
          "from_node_id": {
            "type": "string"
          },
          "to_node_id": {
            "type": "string"
          },
          "district_pair": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "ruling": {
            "enum": [
              "remove",
              "becomes_transport",
              "keep"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "enum": [
          "canon",
          "draft"
        ]
      }
    }
  },
  "then": {
    "required": [
      "level_band",
      "climate_profile",
      "civilization_style",
      "travel_links",
      "district_ids"
    ]
  }
}
